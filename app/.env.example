# Copy to .env.local to override app/.env.production locally. All optional.
# Public https address where this hub is hosted (e.g. GitHub Pages). The Android
# app uses it to hand signing over to VESPR / Eternl via a CIP-158 deep link.
VITE_HUB_URL=
# The Wisdom site to link from the hub.
VITE_WISDOM_URL=
# Payment key hash allowed to issue course badges (testnets).
VITE_ISSUER_PKH=
